.high-score-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(12, 20, 34);
    background-image: url("project://database/Assets/UI/diversespace-back.png");
}

.high-score-panel {
    width: 620px;
    min-height: 560px;
    padding-top: 42px;
    padding-right: 58px;
    padding-bottom: 48px;
    padding-left: 58px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(82, 211, 190);
    border-right-color: rgb(82, 211, 190);
    border-top-color: rgb(82, 211, 190);
    border-bottom-color: rgb(82, 211, 190);
    background-color: rgb(20, 34, 52);
}

.high-score-title {
    font-size: 72px;
    color: rgb(235, 109, 12);
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 30px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    
}

.high-score-subtitle {
    color: rgb(155, 183, 198);
    font-size: 16px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 28px;
}

.high-score-list {
    flex-grow: 1;
    padding-top: 8px;
    padding-right: 22px;
    padding-bottom: 8px;
    padding-left: 22px;
    background-color: rgb(13, 24, 39);
}

.high-score-list Label {
    min-height: 42px;
    padding-top: 10px;
    padding-bottom: 8px;
    color: rgb(232, 242, 238);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    border-bottom-width: 1px;
    border-bottom-color: rgb(43, 72, 87);
}

#empty-score-entry {
    color: rgb(155, 183, 198);
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.back-button {
    width: 100%;
    height: 42px;
    margin-top: 28px;
    background-color: rgb(82, 211, 190);
    color: rgb(238, 163, 50);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}


.menu-item {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(235, 243, 10);
    letter-spacing: 3px;
    margin-top: 6px;
    margin-bottom: 6px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 24px;
    padding-right: 24px;
    -unity-text-align: middle-center;
    transition-property: color, scale;
    transition-duration: 0.12s;
}

.high-score-list Label:hover {
    color: rgb(0, 255, 140);
    scale: 1.08 1.08;
}