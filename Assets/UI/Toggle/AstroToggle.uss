.astro-toggle,
.astro-toggle-button {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    cursor: link;
    transition-duration: 0.15s;
}

.astro-toggle:hover,
.astro-toggle-button:hover {
    scale: 1.08 1.08;
}

.astro-toggle:active,
.astro-toggle-button:active {
    scale: 0.95 0.95;
}

/* Hide the default checkmark */
.astro-toggle .unity-toggle__checkmark,
.astro-toggle-button .unity-toggle__checkmark {
    display: none;
}

/* Clear default input box styling and apply custom unchecked background image */
.astro-toggle .unity-toggle__input,
.astro-toggle-button .unity-toggle__input {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/UI/Pause5.png");
}

/* Default / Music checked state background image */
.astro-toggle:checked .unity-toggle__input,
.astro-toggle .unity-toggle__input:checked,
.astro-toggle-button:checked .unity-toggle__input,
.astro-toggle-button .unity-toggle__input:checked,
#music-toggle:checked .unity-toggle__input,
#music-toggle .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Play5.png");
}

/* Music toggle unchecked */
#music-toggle .unity-toggle__input {
    background-image: url("project://database/Assets/UI/MuteMusic3.png");
}

/* music  toggle checked */
#music-toggle:checked .unity-toggle__input,
#music-toggle .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/EnableMusic3.png");
}

/* SFX / Effects toggle unchecked */
#sfx-toggle .unity-toggle__input {
    background-image: url("project://database/Assets/UI/MuteEffects3.png");
}

/* SFX / Effects toggle checked */
#sfx-toggle:checked .unity-toggle__input,
#sfx-toggle .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/EnableEffects3.png");
}
