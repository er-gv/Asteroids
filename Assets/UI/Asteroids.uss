.root {
    flex: 1;
    background-image: url("project://database/Assets/UI/diversespace-back.png");
    align-items: center;
    justify-content: center;
}

.title {
    position: absolute;
    top: 0;
    margin-top: 10px;
    font-size: 72px;
    color: rgb(235, 109, 12);
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 60px;
    -unity-text-align: middle-center;
}

.menu-panel {
    align-items: center;
    justify-content: right;
    flex-direction: column;
    gap: 18px;
}

.settings-panel {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 440px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 14px;
    background-color: rgba(28, 34, 48, 0.55);
}

.menu-item {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(235, 243, 10);
    letter-spacing: 3px;
    margin: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 0;
    padding-right: 24px;
    -unity-text-align: middle-left;
    flex-grow: 1;
    transition-property: color, scale;
    transition-duration: 0.12s;
}

.menu-item:hover {
    color: rgb(0, 255, 140);
    scale: 1.08 1.08;
}

.menu-item:active {
    color: rgb(0, 200, 100);
    scale: 0.96 0.96;
}

.music-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    gap: 12px;
}

.slider-item {
    width: 220px;
    flex-direction: row;
    align-items: center;
}


.difficulty-group {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
    gap: 12px;
}

.difficulty-option {
    font-size: 18px;
    color: rgb(235, 243, 10);
    -unity-font-style: bold;
    padding: 4px 10px;
}


.footer {
    position: absolute;
    bottom: 12px;
    right: 16px;
    font-size: 12px;
    color: rgb(90, 90, 100);
}
