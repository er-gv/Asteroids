.root {
    flex: 1;
    background-image: url("project://database/Assets/UI/diversespace-back.png");
    align-items: center;
    justify-content: center;
}

.title {
    font-size: 72px;
    color: rgb(235, 109, 12);
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-top: 3px;
    margin-bottom: 30px;
    margin-left: auto;
    margin-right: auto;
    height: 30%;
    -unity-text-align: middle-center;
    
}

#main-menu-title {
    background-position-x: center; 
    background-position-y: top 0;
}

#settings-title {
    
    justify-content: flex-start; 
    flex-direction: row; 
    align-self: center; 
    align-content: center; 
    align-items: auto; 
    padding: 5%;
    -unity-text-align: upper-center; 
    -unity-background-scale-mode: stretch-to-fill; 
}    
   

.menu-panel {
    align-items: center;
    justify-content: right;
    flex-direction: column;
    gap: 18px;
}


.settings-panel {
    flex-direction: row;
    justify-content: space-between;
    align-content: center;
    align-items: center;
    width: 550px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(28, 34, 48, 0.55);
}

.menu-item {
    font-size: 45px;
    -unity-font-style: bold;
    color: rgb(235, 243, 10);
    letter-spacing: 3px;
    width: 200px;
    margin: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 0;
    padding-right: 24px;
    -unity-text-align: middle-left;
    flex-grow: 1;
    transition-property: color, scale;
    transition-duration: 0.12s;
}

.main-menu-item {
    font-size: 45px;
    -unity-font-style: bold;
    color: rgb(235, 243, 10);
    letter-spacing: 3px;
    width: 200px;
    margin: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 0;
    padding-right: 24px;
    -unity-text-align: middle-center;
    transition-property: color, scale;
    transition-duration: 0.12s;
}

.menu-item:hover {
    color: rgb(0, 255, 140);
    scale: 1.08 1.08;
}

.menu-item:active {
    color: rgb(0, 200, 100);
    scale: 0.96 0.96;
}

.audio-control-panel {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    gap: 12px;
    justify-content: space-between; 
    align-self: flex-end;
}

.slider-item {
    width: 250px;
    align-items: center;
    align-self: center;
    flex-direction: row; 
    align-content: center;     
}


.difficulty-group {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
    gap: 12px;
}

.difficulty-option {
    font-size: 18px;
    color: rgb(235, 243, 10);
    -unity-font-style: bold;
    padding: 4px 10px;
}


.back-button {
    height: 42px;
    margin-top: 28px;
    margin-left: auto;
    margin-right: auto;
    
   color: rgb(235, 109, 12);
    -unity-font-style: bold;
    font-size: 38px;
    padding: 20%;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}



.footer {
    position: absolute;
    display:block;
    bottom: 12px;
    margin-left: auto;
    margin-right: auto;
    width: 80%;
    font-size: 18px;
    color: rgb(90, 90, 100);
    
}
