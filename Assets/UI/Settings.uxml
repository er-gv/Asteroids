<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Asteroids.uss?fileID=7433441132597879392&amp;guid=618ea87d090c867448279e7d9e864073&amp;type=3#Asteroids"/>
    <Style src="project://database/Assets/UI/Toggle/AstroToggle.uss?fileID=7433441132597879392&amp;guid=5d87d81c8ee56d44fa4d298cf8745149&amp;type=3#AstroToggle"/>
    <engine:VisualElement name="root" class="root">
        <engine:Label name="settings-title" text="SETTINGS" class="title"/>
        <engine:VisualElement name="menu-panel" class="menu-panel">
            
            <engine:VisualElement class="settings-panel">
                <engine:Label text="Music" class="menu-item" />
                <engine:VisualElement class="audio-control-panel">
                    <engine:Slider name="music-slider" low-value="0" high-value="1" value="1" class="slider-item"/>
                    <engine:Toggle name="music-toggle" value="true" class="astro-toggle-button"/>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement class="settings-panel">
                <engine:Label text="Effects" class="menu-item"/>
                <engine:VisualElement class="audio-control-panel">
                    <engine:Slider name="sfx-slider" low-value="0" high-value="1" value="1" class="slider-item" />
                    <engine:Toggle name="sfx-toggle" value="true" class="astro-toggle-button" />
                </engine:VisualElement>
            </engine:VisualElement>

            
            
            
            
            <engine:VisualElement class="settings-panel">
                <engine:Label name="back-button" text="Back" class="back-button"/>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
