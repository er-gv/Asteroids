

.panel {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: auto;
    height: 200px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 14px;
    background-color: rgba(168, 182, 215, 0.55);
}

.control-button {
    width: 200px;
    height: 200px;
    padding: 10px;
    border-width: 2px;
    border-color: rgb(124, 252, 0);
    border-radius: 2px;
}

/* ----------------------------- Exit Button ------------------------------ */
#ExitBtn {
    
    border-width: 0;
    background-image: url("project://database/Assets/UI/Sprites/Exit3.png");
    background-color: rgba(0, 0, 0, 0);
}

#ExitBtn:hover {
    background-image: url("project://database/Assets/UI/Sprites/Exit5.png");
}

#ExitBtn:active {
    background-image: url("project://database/Assets/UI/Sprites/Exit2.png");
}

#ExitBtn:disabled {
    background-image: url("project://database/Assets/UI/Sprites/Exit1.png");
}

/**----------------------------- Settings Button ------------------------------ */

#SettingsBtn {
    
    border-width: 0;
    background-image: url("project://database/Assets/UI/Sprites/Gear3.png");
    background-color: rgba(0, 0, 0, 0);
}

#SettingsBtn:hover {
    background-image: url("project://database/Assets/UI/Sprites/Gear5.png");
}

#SettingsBtn:active {
    background-image: url("project://database/Assets/UI/Sprites/Gear2.png");
}

#SettingsBtn:disabled {
    background-image: url("project://database/Assets/UI/Sprites/Gear1.png");
}

/* ----------------------------- Toggle Pause Play ------------------------------ */
#PausePlayToggle .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause3.png");
}
#PausePlayToggle:hover .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause5.png");
}
#PausePlayToggle:active .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause2.png");
}
#PausePlayToggle:disabled .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause1.png");
}

/*----------------------------------------------------------------------------------------*/

#PausePlayToggle:checked .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play3.png");
}
#PausePlayToggle:checked:hover .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play5.png");
}
#PausePlayToggle:checked:active .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play2.png");
}
#PausePlayToggle:checked:disabled .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play1.png");
}

.footer {
    position: absolute;
    bottom: 12px;
    right: 16px;
    font-size: 12px;
    color: rgb(90, 90, 100);
}
