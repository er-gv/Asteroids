.panel {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: auto;
    height: 200px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 14px;
    background-color: rgba(168, 182, 215, 0.55);
}

.audio-control-panel {
    align-items: stretch;
    justify-content: space-between;
    align-self: flex-end;
}

#score-panel {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: auto;
    top: 0;
    left: 0;
    height: 200px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-radius: 14px;
    background-color: rgb(68, 182, 21);
}

#score-label {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.control-button {
    width: 200px;
    height: 200px;
    padding: 10px;
    border-width: 2px;
    border-color: rgb(124, 252, 0);
    border-radius: 2px;
}

#ExitBtn {
    border-width: 0;
    background-image: url("project://database/Assets/UI/Sprites/Exit3.png?fileID=21300000&guid=81811dcd09ed00d43a58769ca3e1ff1e&type=3#Exit3");
    background-color: rgba(0, 0, 0, 0);
}

#ExitBtn:hover {
    background-image: url("project://database/Assets/UI/Sprites/Exit5.png?fileID=21300000&guid=5b8d4d341076c7b4794c0b2c60b51d32&type=3#Exit5");
}

#ExitBtn:active {
    background-image: url("project://database/Assets/UI/Sprites/Exit2.png?fileID=21300000&guid=e04b41e8953749049b2c4f663362fde0&type=3#Exit2");
}

#ExitBtn:disabled {
    background-image: url("project://database/Assets/UI/Sprites/Exit1.png?fileID=21300000&guid=4d108bb6587ee2744b1a8a75fa25c628&type=3#Exit1");
}

#SettingsBtn {
    border-width: 0;
    background-image: url("project://database/Assets/UI/Sprites/Gear3.png?fileID=21300000&guid=72a6236dff49da043b0fb50e113e4fbc&type=3#Gear3");
    background-color: rgba(0, 0, 0, 0);
}

#SettingsBtn:hover {
    background-image: url("project://database/Assets/UI/Sprites/Gear5.png?fileID=21300000&guid=fa3eba4cc63f51841ac5e32f2788465a&type=3#Gear5");
}

#SettingsBtn:active {
    background-image: url("project://database/Assets/UI/Sprites/Gear2.png?fileID=21300000&guid=fc1c3f75b4cc06944a4059f0282ed200&type=3#Gear2");
}

#SettingsBtn:disabled {
    background-image: url("project://database/Assets/UI/Sprites/Gear1.png?fileID=21300000&guid=d35c5023a693a064280e2cb62e5ac099&type=3#Gear1");
}

#PausePlayToggle .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause3.png?fileID=21300000&guid=5cdfaa54e3d384e448c62ded14e26618&type=3#Pause3");
}

#PausePlayToggle:hover .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause5.png?fileID=21300000&guid=24b0edab49cb32942b7ed5011a2ae0a7&type=3#Pause5");
}

#PausePlayToggle:active .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause2.png?fileID=21300000&guid=9f8a73a07adbba04a98065517e61ce1f&type=3#Pause2");
}

#PausePlayToggle:disabled .unity-toggle__input {
    background-image: url("project://database/Assets/UI/Sprites/Pause1.png?fileID=21300000&guid=bad63ff130c34b24a8965826ccbb5645&type=3#Pause1");
}

#PausePlayToggle:checked .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play3.png?fileID=21300000&guid=dade247168ebaaf439bfad82e5cb03ad&type=3#Play3");
}

#PausePlayToggle:checked:hover .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play5.png?fileID=21300000&guid=b7410cec77679444b85c46e708af5192&type=3#Play5");
}

#PausePlayToggle:checked:active .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play2.png?fileID=21300000&guid=6dd4bce7556073343926b5ce91ed12ce&type=3#Play2");
}

#PausePlayToggle:checked:disabled .unity-toggle__input:checked {
    background-image: url("project://database/Assets/UI/Sprites/Play1.png?fileID=21300000&guid=ed1a2b31aa904ea4b8cfdceed027875e&type=3#Play1");
}

.footer {
    position: absolute;
    bottom: 12px;
    right: 16px;
    font-size: 12px;
    color: rgb(90, 90, 100);
}


